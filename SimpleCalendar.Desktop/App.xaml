<Application x:Class="SimpleCalendar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 布尔值转可见性转换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <!-- 日历弹窗主题色（默认深色） -->
            <SolidColorBrush x:Key="PopupBackground" Color="#1E1E2E"/>
            <SolidColorBrush x:Key="PopupBorder" Color="#3A3A4A"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#E8E8F0"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#888899"/>
            <SolidColorBrush x:Key="TextLunar" Color="#777788"/>
            <SolidColorBrush x:Key="DividerColor" Color="#333344"/>
            <SolidColorBrush x:Key="HolidayColor" Color="#EF4444"/>
            <SolidColorBrush x:Key="WorkdayColor" Color="#F59E0B"/>
            <SolidColorBrush x:Key="TodayColor" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
            <SolidColorBrush x:Key="NavButtonHover" Color="#333344"/>
            
            <!-- 天气卡片颜色 -->
            <SolidColorBrush x:Key="WeatherCardBg" Color="#252535"/>
            <SolidColorBrush x:Key="WeatherIconColor" Color="#70AAEE"/>
            <SolidColorBrush x:Key="WeatherDescColor" Color="#88BBDD"/>
            <SolidColorBrush x:Key="WeatherHourlyBg" Color="#2A2A3D"/>
            <SolidColorBrush x:Key="WeatherCardActive" Color="#3B82F6"/>
            
            <!-- 设置窗口主题色 -->
            <SolidColorBrush x:Key="SettingsBg" Color="#1E1E2E"/>
            <SolidColorBrush x:Key="SettingsTitle" Color="#E8E8F0"/>
            <SolidColorBrush x:Key="SettingsLabel" Color="#AAAABB"/>
            <SolidColorBrush x:Key="SettingsText" Color="#E8E8F0"/>
            <SolidColorBrush x:Key="SettingsInputBg" Color="#2D2D3D"/>
            <SolidColorBrush x:Key="SettingsInputBorder" Color="#404055"/>
            <SolidColorBrush x:Key="SettingsBtnPrimary" Color="#3B82F6"/>
            <SolidColorBrush x:Key="SettingsBtnPrimaryText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SettingsBtnSecondary" Color="#2D2D3D"/>
            <SolidColorBrush x:Key="SettingsBtnSecondaryText" Color="#E8E8F0"/>
            <SolidColorBrush x:Key="SettingsDropdownBg" Color="#2D2D3D"/>
            <SolidColorBrush x:Key="SettingsDropdownText" Color="#E8E8F0"/>
            <SolidColorBrush x:Key="SettingsNavBg" Color="#252535"/>
            <SolidColorBrush x:Key="SettingsContentBg" Color="#1A1A28"/>
            <SolidColorBrush x:Key="NavRadioActive" Color="#3B82F6"/>
            <SolidColorBrush x:Key="NavRadioHover" Color="#333344"/>

            <!-- AI 聊天窗口默认主题色（#262626 面板 / #1E1E1E 输入框 / #171717 对话区） -->
            <SolidColorBrush x:Key="ChatBg" Color="#262626"/>
            <SolidColorBrush x:Key="ChatHeaderBg" Color="#262626"/>
            <SolidColorBrush x:Key="ChatInputBg" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="ChatBorder" Color="#2A2A30"/>
            <SolidColorBrush x:Key="ChatTextMain" Color="#E8E8EC"/>
            <SolidColorBrush x:Key="ChatTextMuted" Color="#9090A0"/>
            <SolidColorBrush x:Key="ChatTextUser" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ChatAccent" Color="#1678FF"/>
            <SolidColorBrush x:Key="ChatUserBubble" Color="#1678FF"/>
            <SolidColorBrush x:Key="ChatAssistantBubble" Color="#171717"/>
            <SolidColorBrush x:Key="ChatReasoningBg" Color="#1F1F28"/>
            <SolidColorBrush x:Key="ChatReasoningBorder" Color="#3A3A45"/>
            <SolidColorBrush x:Key="ChatHistoryBg" Color="#262626"/>
            <SolidColorBrush x:Key="ChatHistoryItemBg" Color="#22222C"/>
            <SolidColorBrush x:Key="ChatHistoryItemHover" Color="#2A2A35"/>
            <SolidColorBrush x:Key="ChatHistoryItemActive" Color="#E8763A"/>
            <SolidColorBrush x:Key="ChatCodeBg" Color="#15151C"/>
            <SolidColorBrush x:Key="ChatCodeBorder" Color="#33333F"/>
            <SolidColorBrush x:Key="ChatErrorText" Color="#EF4444"/>
            <SolidColorBrush x:Key="ChatSuccessText" Color="#16A34A"/>
            <SolidColorBrush x:Key="ChatScrollbarBg" Color="#1B1B23"/>
            <!-- 对话区背景（消息列表 ScrollViewer） -->
            <SolidColorBrush x:Key="ChatConversationBg" Color="#171717"/>
            <!-- 新对话/发送按钮悬浮色 -->
            <SolidColorBrush x:Key="ChatButtonHover" Color="#1678FF"/>

            <!-- AI 聊天 ComboBox 样式（继承设置 ComboBox 配色，但用 Chat 资源） -->
            <Style x:Key="ChatComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource ChatInputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource ChatTextMain}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ChatBorder}"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton"
                                            Background="Transparent" BorderThickness="0"
                                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Focusable="False" ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="0,0,6,0">
                                                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                                              Fill="{DynamicResource ChatTextMuted}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ContentSite"
                                            IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            Margin="8,4,26,4"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ChatTextMain}"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                                <Popup x:Name="Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{DynamicResource ChatInputBg}" 
                                            BorderBrush="{DynamicResource ChatBorder}" BorderThickness="1"
                                            CornerRadius="4" Margin="0,2,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            Padding="0,2">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.3" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="280">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- AI 聊天 ComboBoxItem 样式 -->
            <Style x:Key="ChatComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource ChatTextMain}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    CornerRadius="2" Margin="2,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChatHistoryItemHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChatHistoryItemActive}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- AI 聊天 TextBox 样式（多行） -->
            <Style x:Key="ChatTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ChatInputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource ChatTextMain}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ChatBorder}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource ChatTextMain}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource ChatAccent}"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- AI 聊天按钮样式（主按钮） -->
            <Style x:Key="ChatPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ChatAccent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="14,2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChatButtonHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- AI 聊天按钮样式（次要按钮/图标按钮） -->
            <Style x:Key="ChatIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ChatTextMuted}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChatHistoryItemHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ChatTextMain}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- AI 历史记录 ListBoxItem 样式 -->
            <Style x:Key="ChatHistoryListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource ChatTextMain}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    CornerRadius="4" Margin="2,1">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChatHistoryItemHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChatHistoryItemActive}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 导航按钮样式 -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource NavButtonHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 星期头样式 -->
            <Style x:Key="WeekHeaderStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>
            
            <!-- 设置窗口 ComboBox 样式 -->
            <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource SettingsInputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource SettingsDropdownText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton"
                                            Background="Transparent" BorderThickness="0"
                                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Focusable="False" ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="0,0,8,0">
                                                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                                              Fill="{DynamicResource SettingsLabel}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ContentSite"
                                            IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            Margin="8,6,30,6"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SettingsDropdownText}"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                                <Popup x:Name="Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{DynamicResource SettingsDropdownBg}" 
                                            BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1"
                                            CornerRadius="4" Margin="0,2,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            Padding="0,2">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.3" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="200">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- ComboBoxItem 样式 -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource SettingsDropdownText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    CornerRadius="2" Margin="2,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavButtonHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SettingsBtnPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- 设置窗口 TextBox 样式 -->
            <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource SettingsInputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource SettingsText}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- 设置窗口 CheckBox 样式 -->
            <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
                <Setter Property="Padding" Value="4,0,0,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CheckBorder" Width="18" Height="18" 
                                        BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1.5"
                                        CornerRadius="3" Background="Transparent"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CheckMark" Text="✓" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource SettingsBtnPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource SettingsBtnPrimary}"/>
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource SettingsBtnPrimary}"/>
                                    <Setter TargetName="CheckMark" Property="Foreground" Value="White"/>
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- 设置窗口按钮样式 - 主按钮 -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SettingsBtnPrimary}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" 
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="#3B82F6" Direction="270"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4F92FF"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#3B82F6" Direction="270"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                    <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- 设置窗口按钮样式 - 次要按钮 -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SettingsBtnSecondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource SettingsBtnSecondaryText}"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" 
                                    Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A3A4C"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                    <Setter Property="Foreground" Value="#E2E8F0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#323242"/>
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slider 样式（简化） -->
            <Style x:Key="SettingsSliderStyle" TargetType="Slider">
                <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
            </Style>

            <!-- 设置窗口导航 RadioButton 样式 -->
            <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource SettingsLabel}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavRadioHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavRadioActive}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 全局滚动条美化：细、半透明、悬停加深、默认几乎不可见 ===== -->
            <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Width" Value="6"/>
                <Setter Property="MinWidth" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="False">
                        <Setter Property="Opacity" Value="0.35"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.85"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 垂直滚动条模板（极简细条） -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                <Style.Resources>
                    <Style TargetType="RepeatButton">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Border Background="Transparent"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                    <Setter Property="IsTabStop" Value="False"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="ThumbBg"
                                                                        Background="{DynamicResource TextSecondary}"
                                                                        CornerRadius="3"
                                                                        Margin="1,0"
                                                                        Opacity="0.3"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBg" Property="Opacity" Value="0.7"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 自定义 Expander 样式：去除默认下拉箭头，仅显示 Header 内容，内容水平拉伸 -->
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel>
                                    <!-- Header 区：用 ToggleButton 包装实现点击切换，模板内只放 ContentPresenter -->
                                    <ToggleButton x:Name="HeaderSite"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  IsTabStop="False"
                                                  Focusable="False"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Cursor="Hand"
                                                  Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!-- 内容区：展开时显示 -->
                                    <ContentPresenter x:Name="ExpandSite"
                                                      ContentSource="Content"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Top"
                                                      Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 全局 ScrollViewer 样式：默认隐藏滚动条，悬停显示 -->
            <Style TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <ScrollContentPresenter Margin="{TemplateBinding Padding}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <!-- 垂直滚动条：默认隐藏，悬停淡入 -->
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           HorizontalAlignment="Right"
                                           Orientation="Vertical"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                           Opacity="0">
                                    <ScrollBar.Style>
                                        <Style TargetType="ScrollBar">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True"/>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Visibility}" Value="Visible"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollBar.Style>
                                </ScrollBar>
                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           VerticalAlignment="Bottom"
                                           Orientation="Horizontal"
                                           Value="{TemplateBinding HorizontalOffset}"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                           Opacity="0"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
