<Window x:Class="SimpleCalendar.Windows.ModelEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑模型"
        Width="560" Height="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource SettingsBg}" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="新建模型" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource SettingsTitle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" FontSize="13" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource SettingsLabel}" Cursor="Hand"
                        Click="Cancel_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="显示名称" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SettingsLabel}"/>
                        <TextBox x:Name="NameBox" Grid.Column="1"
                                 Style="{DynamicResource SettingsTextBoxStyle}"
                                 ToolTip="在AI对话框顶部显示的名称，如：DeepSeek-Chat"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="服务商" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SettingsLabel}"/>
                        <ComboBox x:Name="ProviderCombo" Grid.Column="1"
                                  Style="{DynamicResource SettingsComboBoxStyle}"
                                  SelectionChanged="Provider_SelectionChanged"/>
                    </Grid>

                    <TextBlock x:Name="ProviderDesc" Text="" FontSize="11" Margin="80,0,0,10"
                               Foreground="{DynamicResource SettingsLabel}" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="API 地址" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SettingsLabel}"/>
                        <TextBox x:Name="ApiUrlBox" Grid.Column="1"
                                 Style="{DynamicResource SettingsTextBoxStyle}"
                                 ToolTip="OpenAI兼容接口的基础地址，如：https://api.deepseek.com/v1"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模型名称" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SettingsLabel}"/>
                        <TextBox x:Name="ModelBox" Grid.Column="1"
                                 Style="{DynamicResource SettingsTextBoxStyle}"
                                 ToolTip="如：deepseek-chat、gpt-4o-mini、qwen-turbo"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="API Key" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SettingsLabel}"/>
                        <TextBox x:Name="ApiKeyBox" Grid.Column="1"
                                 Style="{DynamicResource SettingsTextBoxStyle}"
                                 ToolTip="服务商提供的API密钥"/>
                    </Grid>

                    <!-- 测试按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="80,4,0,0">
                        <Button Content="🔌 测试连通" Width="100" Height="30"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="Test_Click"/>
                        <TextBlock x:Name="TestResultText" Text="" FontSize="11"
                                   Foreground="{DynamicResource SettingsLabel}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button Content="取消" Width="72" Height="32" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="Cancel_Click"/>
                <Button Content="保存" Width="72" Height="32"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
