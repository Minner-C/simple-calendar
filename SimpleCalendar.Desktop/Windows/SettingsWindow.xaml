<Window x:Class="SimpleCalendar.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时钟设置"
        WindowStyle="None"
        ResizeMode="NoResize"
                        Width="720" Height="620"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">

    <Border x:Name="RootBorder" Padding="0" Background="{DynamicResource SettingsBg}" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="24,20,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚙ 任务栏时钟设置" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource SettingsTitle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" FontSize="14" Width="32" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource SettingsLabel}"
                        Cursor="Hand" Click="Cancel_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 主体：左侧导航 + 右侧内容 -->
            <Grid Grid.Row="1" Margin="24,0,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" Background="{DynamicResource SettingsNavBg}" CornerRadius="8" Margin="0,0,12,0">
                    <StackPanel Margin="8,12">
                        <RadioButton x:Name="NavGeneral" Content="🛠 通用设置" Margin="4,4,4,2"
                                     Style="{DynamicResource NavRadioButtonStyle}" IsChecked="True"
                                     Click="Nav_Click"/>
                        <RadioButton x:Name="NavAppearance" Content="🎨 外观设置" Margin="4,2,4,2"
                                     Style="{DynamicResource NavRadioButtonStyle}"
                                     Click="Nav_Click"/>
                        <RadioButton x:Name="NavWeather" Content="🌤 天气设置" Margin="4,2,4,2"
                                     Style="{DynamicResource NavRadioButtonStyle}"
                                     Click="Nav_Click"/>
                        <RadioButton x:Name="NavMonitor" Content="📊 监控面板" Margin="4,2,4,2"
                                     Style="{DynamicResource NavRadioButtonStyle}"
                                     Click="Nav_Click"/>
                        <RadioButton x:Name="NavAI" Content="✨ AI设置" Margin="4,2,4,2"
                                     Style="{DynamicResource NavRadioButtonStyle}"
                                     Click="Nav_Click"/>
                        <RadioButton x:Name="NavAdvanced" Content="⚙ 高级设置" Margin="4,2,4,4"
                                     Style="{DynamicResource NavRadioButtonStyle}"
                                     Click="Nav_Click"/>
                    </StackPanel>
                </Border>

                <!-- 右侧内容区 -->
                <Border Grid.Column="1" Background="{DynamicResource SettingsContentBg}" CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                        <Grid Margin="20,16">

                            <!-- 通用设置页 -->
                            <StackPanel x:Name="PageGeneral" Visibility="Visible">
                                <TextBlock Text="通用设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,16"/>

                                <TextBlock Text="距离左侧边界（像素）" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                <TextBox x:Name="LeftOffsetBox" Style="{DynamicResource SettingsTextBoxStyle}" Margin="0,0,0,16" MaxWidth="200" HorizontalAlignment="Left"/>

                                <CheckBox x:Name="ShowSecondsCheck" Content="显示秒数" Margin="0,0,0,12"
                                          Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                <CheckBox x:Name="ShowLunarCheck" Content="显示农历" Margin="0,0,0,12"
                                          Style="{DynamicResource SettingsCheckBoxStyle}"/>

                                <CheckBox x:Name="AutoStartCheck" Content="开机自启动" Margin="0,0,0,12"
                                          Style="{DynamicResource SettingsCheckBoxStyle}"
                                          ToolTip="开机时自动启动 SimpleCalendar"/>
                            </StackPanel>

                            <!-- 外观设置页 -->
                            <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                                <TextBlock Text="外观设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,16"/>

                                <TextBlock Text="应用主题" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                <ComboBox x:Name="ThemeModeCombo" Style="{DynamicResource SettingsComboBoxStyle}" Margin="0,0,0,16" MaxWidth="240" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="跟随系统" Tag="system"/>
                                    <ComboBoxItem Content="深色模式" Tag="dark"/>
                                    <ComboBoxItem Content="浅色模式" Tag="light"/>
                                </ComboBox>

                                <TextBlock Text="时钟文字配色" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                <ComboBox x:Name="ColorSchemeCombo" Style="{DynamicResource SettingsComboBoxStyle}" Margin="0,0,0,16" MaxWidth="240" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="自动（跟随任务栏）" Tag="auto"/>
                                    <ComboBoxItem Content="深色主题（白色文字）" Tag="dark"/>
                                    <ComboBoxItem Content="浅色主题（黑色文字）" Tag="light"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 天气设置页 -->
                            <StackPanel x:Name="PageWeather" Visibility="Collapsed">
                                <TextBlock Text="天气设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,16"/>

                                <CheckBox x:Name="ShowWeatherCheck" Content="显示天气预报" Margin="0,0,0,12"
                                          Style="{DynamicResource SettingsCheckBoxStyle}"
                                          Checked="ShowWeatherCheck_Changed" Unchecked="ShowWeatherCheck_Changed"/>

                                <StackPanel x:Name="WeatherCityPanel" Margin="0,0,0,0">
                                    <TextBlock Text="天气接口" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                    <ComboBox x:Name="WeatherProviderCombo" Style="{DynamicResource SettingsComboBoxStyle}" Margin="0,0,0,12" MaxWidth="300" HorizontalAlignment="Left"
                                              SelectionChanged="WeatherProviderCombo_SelectionChanged">
                                        <ComboBoxItem Content="自动（依次尝试）" Tag="auto"/>
                                        <ComboBoxItem Content="消息盒子（气象局，免Key，IP定位）" Tag="apihz"/>
                                        <ComboBoxItem Content="Open-Meteo（国外，免Key）" Tag="openmeteo"/>
                                        <ComboBoxItem Content="wttr.in（国外，免Key）" Tag="wttr"/>
                                        <ComboBoxItem Content="高德天气（国内，需Key）" Tag="gaode"/>
                                    </ComboBox>

                                    <StackPanel x:Name="CityConfigPanel">
                                        <TextBlock Text="省份" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                        <ComboBox x:Name="ProvinceCombo" Style="{DynamicResource SettingsComboBoxStyle}" Margin="0,0,0,8"
                                                  MaxWidth="240" HorizontalAlignment="Left"
                                                  SelectionChanged="ProvinceCombo_SelectionChanged"/>
                                        <TextBlock Text="城市" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                        <ComboBox x:Name="CityCombo" Style="{DynamicResource SettingsComboBoxStyle}" Margin="0,0,0,16" MaxWidth="240" HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <TextBlock Text="高德天气Key（可选，高德接口必填）" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                    <TextBox x:Name="GaodeWeatherKeyBox" Style="{DynamicResource SettingsTextBoxStyle}"
                                             Margin="0,0,0,8" MaxWidth="400" HorizontalAlignment="Left"
                                             ToolTip="申请地址: https://lbs.amap.com"/>

                                    <StackPanel x:Name="ApiHzConfigPanel" Visibility="Collapsed">
                                        <TextBlock Text="消息盒子开发者ID（apihz.cn）" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                        <TextBox x:Name="ApiHzIdBox" Style="{DynamicResource SettingsTextBoxStyle}"
                                                 Margin="0,0,0,8" MaxWidth="400" HorizontalAlignment="Left"
                                                 ToolTip="到apihz.cn注册获取，不填则使用公共测试ID（有频率限制）"/>
                                        <TextBlock Text="消息盒子开发者KEY（apihz.cn）" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                        <TextBox x:Name="ApiHzKeyBox" Style="{DynamicResource SettingsTextBoxStyle}"
                                                 Margin="0,0,0,8" MaxWidth="400" HorizontalAlignment="Left"
                                                 ToolTip="到apihz.cn注册获取，不填则使用公共测试KEY（有频率限制）"/>
                                    </StackPanel>

                                    <TextBlock x:Name="ApiHzHint" Text="💡 消息盒子接口：由中国气象局提供数据源，自动根据IP定位。强烈建议到apihz.cn注册免费账号获取专属ID/KEY，避免公共KEY限流"
                                               FontSize="10" Foreground="#60A5FA" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>

                                    <!-- 接口测试按钮 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="🔌 测试接口连通" MinWidth="120"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                Click="TestWeather_Click"/>
                                        <TextBlock x:Name="TestResultText" Text="" FontSize="11"
                                                   Foreground="{DynamicResource SettingsLabel}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   TextWrapping="Wrap" MaxWidth="380"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 监控面板设置页 -->
                            <StackPanel x:Name="PageMonitor" Visibility="Collapsed">
                                <TextBlock Text="监控面板设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,16"/>

                                <CheckBox x:Name="MonitorEnabledCheck" Content="在任务栏显示监控面板" Margin="0,0,0,16"
                                          Style="{DynamicResource SettingsCheckBoxStyle}"/>

                                <TextBlock Text="显示项目（每项均为独立进度条，可单独开关）" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                <StackPanel Margin="20,0,0,12">
                                    <CheckBox x:Name="MonitorShowCpuCheck" Content="CPU 使用率（独立进度条）" Margin="0,0,0,8"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                    <CheckBox x:Name="MonitorShowCpuTempCheck" Content="CPU 温度（独立进度条，最大 100°C）" Margin="0,0,0,8"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                    <CheckBox x:Name="MonitorShowMemCheck" Content="内存（百分比 + 容量）" Margin="0,0,0,8"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                    <CheckBox x:Name="MonitorShowGpuCheck" Content="GPU 使用率（独立进度条，需NVIDIA显卡）" Margin="0,0,0,8"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                    <CheckBox x:Name="MonitorShowGpuTempCheck" Content="GPU 温度（独立进度条，最大 100°C，需NVIDIA显卡）" Margin="0,0,0,8"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                    <CheckBox x:Name="MonitorShowTokenCheck" Content="Token 用量（今日 token 消耗）" Margin="0,0,0,8"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                    <CheckBox x:Name="MonitorShowVolumeCheck" Content="音量调节（可拖动进度条调节系统音量）" Margin="0,0,0,8"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                    <CheckBox x:Name="MonitorShowBrightnessCheck" Content="亮度调节（可拖动进度条调节屏幕亮度，需支持WMI的显示器）" Margin="0,0,0,8"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                </StackPanel>

                                <TextBlock Text="面板布局" FontSize="12" Margin="0,8,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                <ComboBox x:Name="MonitorLayoutCombo" Style="{DynamicResource SettingsComboBoxStyle}" Margin="0,0,0,8" MaxWidth="280" HorizontalAlignment="Left"
                                          SelectionChanged="MonitorLayoutCombo_SelectionChanged">
                                    <ComboBoxItem Content="三行布局（每列最多3项，超出另起一列）" Tag="3"/>
                                    <ComboBoxItem Content="两行布局（每列最多2项，超出另起一列）" Tag="2"/>
                                </ComboBox>
                                <TextBlock Text="根据任务栏空间选择布局：两行布局更紧凑，三行布局容纳更多信息。超出设定行数的监控项会自动排到右侧新列。"
                                           FontSize="10" Foreground="{DynamicResource SettingsLabel}" Margin="0,0,0,12" TextWrapping="Wrap" MaxWidth="420"/>

                                <TextBlock Text="监控配色" FontSize="12" Margin="0,8,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                <ComboBox x:Name="MonitorColorModeCombo" Style="{DynamicResource SettingsComboBoxStyle}" Margin="0,0,0,8" MaxWidth="280" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="彩色（按状态变色：绿/黄/红）" Tag="color"/>
                                    <ComboBoxItem Content="黑白（跟随系统明暗）" Tag="mono"/>
                                </ComboBox>
                                <TextBlock Text="彩色：使用率与温度按状态自动变色；黑白：根据系统明暗使用统一的灰白色或深灰色，降低对比度"
                                           FontSize="10" Foreground="{DynamicResource SettingsLabel}" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>

                            <!-- AI设置页 -->
                            <StackPanel x:Name="PageAI" Visibility="Collapsed">
                                <TextBlock Text="AI设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,16"/>

                                <CheckBox x:Name="AIEnabledCheck" Content="启用AI助手" Margin="0,0,0,16"
                                          Style="{DynamicResource SettingsCheckBoxStyle}"
                                          Checked="AIEnabled_Changed" Unchecked="AIEnabled_Changed"/>

                                <StackPanel x:Name="AIConfigPanel" Margin="0,0,0,0">

                                    <!-- 模型管理区（类似Trae的多模型管理） -->
                                    <Border Background="{DynamicResource SettingsNavBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="模型管理" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SettingsTitle}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="➕ 新建模型" MinWidth="96"
                                                            Style="{DynamicResource SecondaryButtonStyle}"
                                                            Click="AddModel_Click" Margin="0,0,8,0"/>
                                                    <Button Content="✏ 编辑" MinWidth="80"
                                                            Style="{DynamicResource SecondaryButtonStyle}"
                                                            Click="EditModel_Click" Margin="0,0,8,0"/>
                                                    <Button Content="🗑 删除" MinWidth="80"
                                                            Style="{DynamicResource SecondaryButtonStyle}"
                                                            Click="DeleteModel_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="点击列表项可设为当前使用模型，双击可编辑" FontSize="10"
                                                       Foreground="{DynamicResource SettingsLabel}" Margin="0,0,0,8"/>

                                            <ListBox x:Name="ModelListBox" Height="180"
                                                     Background="{DynamicResource SettingsContentBg}"
                                                     Foreground="{DynamicResource SettingsLabel}"
                                                     BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1"
                                                     SelectionChanged="ModelList_SelectionChanged"
                                                     MouseDoubleClick="ModelList_MouseDoubleClick">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource SettingsTitle}"/>
                                                                    <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="3"
                                                                            Background="{DynamicResource SettingsBtnPrimary}"
                                                                            Visibility="{Binding IsActiveBadgeVisibility}">
                                                                        <TextBlock Text="当前" FontSize="9" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Provider}" FontSize="10"
                                                                           Foreground="{DynamicResource SettingsLabel}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Model}" FontSize="10"
                                                                       Foreground="{DynamicResource SettingsLabel}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding ApiUrl}" FontSize="9"
                                                                       Foreground="{DynamicResource SettingsLabel}" Margin="0,1,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <TextBlock Text="提示：可添加多个模型（如DeepSeek、通义千问、智谱等），在AI对话框顶部切换"
                                                       FontSize="10" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource SettingsLabel}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Agent 配置区（单一通用助手，只读展示 + 编辑提示词） -->
                                    <Border Background="{DynamicResource SettingsNavBg}" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🤖 AI 助手配置" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SettingsTitle}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="✏ 编辑提示词" MinWidth="100"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Click="EditAgent_Click"/>
                                            </Grid>

                                            <Border Background="{DynamicResource SettingsContentBg}" CornerRadius="4" Padding="10,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="✨" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                   FontFamily="Segoe UI Emoji"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="AI 助手" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SettingsTitle}"/>
                                                            <TextBlock Text="全能助手 · 自动调用技能和工具" FontSize="10"
                                                                       Foreground="{DynamicResource SettingsLabel}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Text="系统内置单一通用助手，无需切换。所有专业能力（公文写作、会议纪要、代码审查等）通过 Skills 自动调用，外部工具通过 MCP 全局接入。点击右上角&quot;编辑提示词&quot;可自定义助手行为。"
                                                               FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SettingsLabel}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- MCP 服务器 / Skills 扩展能力入口 -->
                                    <Border Background="{DynamicResource SettingsNavBg}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🔌 扩展能力" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="MCP 服务器提供外部工具接入（网页抓取、文件系统、GitHub 等）；Skills 提供可复用的专业能力（公文写作、会议纪要等）。两者均全局自动启用，AI 会按需调用。"
                                                       FontSize="10" Foreground="{DynamicResource SettingsLabel}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" x:Name="ManageMcpBtn" Click="ManageMcp_Click"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        HorizontalContentAlignment="Stretch" Margin="0,0,6,0" MinHeight="56">
                                                    <StackPanel>
                                                        <TextBlock Text="🔌 MCP 服务器管理" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SettingsTitle}"/>
                                                        <TextBlock x:Name="McpSummaryText" Text="点击管理已连接的外部工具"
                                                                   FontSize="10" Foreground="{DynamicResource SettingsLabel}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" x:Name="ManageSkillsBtn" Click="ManageSkills_Click"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        HorizontalContentAlignment="Stretch" Margin="6,0,0,0" MinHeight="56">
                                                    <StackPanel>
                                                        <TextBlock Text="⚡ Skills 管理" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SettingsTitle}"/>
                                                        <TextBlock x:Name="SkillsSummaryText" Text="点击管理提示词能力"
                                                                   FontSize="10" Foreground="{DynamicResource SettingsLabel}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 讯飞语音转写配置区 -->
                                    <Border Background="{DynamicResource SettingsNavBg}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🎙 语音转写" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="支持两种转写方式：1) Windows系统语音识别（免费，无需配置）；2) 科大讯飞API（准确率更高，需配置）。会议纪要Agent会优先使用讯飞，未配置时回退到系统识别。"
                                                       FontSize="10" Foreground="{DynamicResource SettingsLabel}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                            <CheckBox x:Name="XfyunEnabledCheck" Content="启用科大讯飞语音转写（不勾选则使用Windows系统识别）" Margin="0,0,0,10"
                                                      Style="{DynamicResource SettingsCheckBoxStyle}"/>

                                            <TextBlock Text="讯飞 AppID" FontSize="11" Margin="0,0,0,4" Foreground="{DynamicResource SettingsLabel}"/>
                                            <TextBox x:Name="XfyunAppIdBox" Style="{DynamicResource SettingsTextBoxStyle}"
                                                     Width="320" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                                            <TextBlock Text="讯飞 APIKey" FontSize="11" Margin="0,0,0,4" Foreground="{DynamicResource SettingsLabel}"/>
                                            <TextBox x:Name="XfyunApiKeyBox" Style="{DynamicResource SettingsTextBoxStyle}"
                                                     Width="320" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                                            <TextBlock Text="讯飞 APISecret" FontSize="11" Margin="0,0,0,4" Foreground="{DynamicResource SettingsLabel}"/>
                                            <TextBox x:Name="XfyunApiSecretBox" Style="{DynamicResource SettingsTextBoxStyle}"
                                                     Width="320" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                                            <TextBlock Text="申请地址：https://console.xfyun.cn/services/lfasr" FontSize="10"
                                                       Foreground="{DynamicResource SettingsLabel}" Margin="0,0,0,10"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="保存配置" MinWidth="96"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Click="SaveXfyun_Click" Margin="0,0,8,0"/>
                                                <Button Content="测试连通" MinWidth="96"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Click="TestXfyun_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 文件输出目录配置 -->
                                    <Border Background="{DynamicResource SettingsNavBg}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="📁 文件输出目录" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,8"/>
                                            <TextBlock Text="设置AI生成的Word文档、录音文件等的保存位置（留空使用默认目录：我的文档\SimpleCalendar）"
                                                       FontSize="10" Foreground="{DynamicResource SettingsLabel}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="DocumentOutputPathBox" Style="{DynamicResource SettingsTextBoxStyle}"
                                                         Margin="0,0,8,0" Padding="8,6"
                                                         ToolTip="留空则使用默认目录（我的文档\SimpleCalendar）"/>
                                                <Button Grid.Column="1" Content="浏览..." MinWidth="80"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Click="BrowseOutputPath_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="OutputPathHint" Text="" FontSize="10"
                                                       Foreground="{DynamicResource SettingsLabel}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Token 用量统计 -->
                                    <Border Background="{DynamicResource SettingsNavBg}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="📊 Token 用量统计" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SettingsTitle}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="单位：" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SettingsLabel}"/>
                                                    <ComboBox x:Name="TokenUnitCombo" Width="80" FontSize="11" Margin="6,0,0,0"
                                                              SelectionChanged="TokenUnitCombo_SelectionChanged">
                                                        <ComboBoxItem Content="百万 (M)" Tag="M"/>
                                                        <ComboBoxItem Content="亿 (Y)" Tag="Y"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#11FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                                    <StackPanel>
                                                        <TextBlock Text="累计总量" FontSize="10" Foreground="{DynamicResource SettingsLabel}"/>
                                                        <TextBlock x:Name="TokenTotalText" Text="0.00 M" FontSize="18" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SettingsTitle}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="#11FFFFFF" CornerRadius="6" Padding="10,8">
                                                    <StackPanel>
                                                        <TextBlock Text="今日用量" FontSize="10" Foreground="{DynamicResource SettingsLabel}"/>
                                                        <TextBlock x:Name="TokenTodayText" Text="0.00 M" FontSize="18" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SettingsTitle}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="日用量阈值（作为监控面板进度条总值）" FontSize="11" Margin="0,10,0,4"
                                                       Foreground="{DynamicResource SettingsLabel}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBox x:Name="TokenThresholdBox" Width="120" FontSize="11"
                                                          Style="{DynamicResource SettingsTextBoxStyle}"
                                                          LostFocus="TokenThreshold_LostFocus"/>
                                                <TextBlock x:Name="TokenThresholdUnit" Text="（百万）" FontSize="10"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource SettingsLabel}"/>
                                                <Button Content="应用" Width="60" Style="{DynamicResource SecondaryButtonStyle}"
                                                        Padding="6,3" Margin="8,0,0,0" Click="TokenThresholdApply_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="今日用量达到阈值时，监控面板进度条显示为满格并变红。当前单位跟随上方选择（百万或亿）。"
                                                       FontSize="9" Foreground="{DynamicResource SettingsLabel}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TokenModelBreakdown" Text="" FontSize="10"
                                                       Foreground="{DynamicResource SettingsLabel}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <Button x:Name="ClearTokenBtn" Content="清空统计" Width="90" HorizontalAlignment="Left"
                                                    Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" Margin="0,8,0,0"
                                                    Click="ClearToken_Click"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </StackPanel>

                            <!-- 高级设置页 -->
                            <StackPanel x:Name="PageAdvanced" Visibility="Collapsed">
                                <TextBlock Text="高级设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsTitle}" Margin="0,0,0,16"/>

                                <TextBlock Text="后台API地址" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                <TextBox x:Name="ApiUrlBox" Style="{DynamicResource SettingsTextBoxStyle}"
                                         Margin="0,0,0,16" MaxWidth="400" HorizontalAlignment="Left"
                                         ToolTip="用于获取黄历宜忌和广告数据"/>

                                <TextBlock Text="关于" FontSize="12" Margin="0,8,0,6" Foreground="{DynamicResource SettingsLabel}"/>
                                <TextBlock Text="SimpleCalendar v1.0.0&#x0a;任务栏时钟与日历&#x0a;支持农历、天气、黄历"
                                           FontSize="11" Foreground="{DynamicResource SettingsLabel}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 底部按钮栏 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                <Button Content="取消" MinWidth="88" Padding="16,0" Margin="0,0,10,0" Click="Cancel_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
                <Button Content="保存" MinWidth="88" Padding="16,0" Click="Save_Click"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
