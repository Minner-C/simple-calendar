<Window x:Class="SimpleCalendar.Windows.SkillManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skills 管理"
        Width="720" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- 美化的滚动条样式 -->
        <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF3A3A4A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border CornerRadius="4" Background="Transparent"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" CornerRadius="4" Background="#FF606070" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF808090" TargetName="thumbBorder"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BeautifulScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1" Grid.Row="0"
                                       Style="{StaticResource ThinScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Column="0" Grid.Row="1"
                                       Orientation="Horizontal"
                                       Style="{StaticResource ThinScrollBarStyle}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF1A1A28" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="Skills 管理" FontSize="15" FontWeight="Bold"
                           Foreground="#FFE0E0E8" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" FontSize="13" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FF9090A0" Cursor="Hand"
                        Click="Close_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 主内容：左侧列表 + 右侧编辑区 -->
            <Grid Grid.Row="1" Margin="20,0,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧 Skill 列表 -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.Row="0">
                        <Button Content="+ 新建" Width="64" Height="26" Margin="0,0,6,0"
                                Background="#FF3B82F6" Foreground="White" BorderThickness="0"
                                FontSize="12" Cursor="Hand" Click="New_Click"/>
                        <Button Content="刷新" Width="50" Height="26"
                                Background="Transparent" Foreground="#FF9090A0"
                                BorderBrush="#FF3A3A4A" BorderThickness="1"
                                FontSize="12" Cursor="Hand" Click="Refresh_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#FF252535" BorderBrush="#FF3A3A4A"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer Style="{StaticResource BeautifulScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="6">
                            <StackPanel x:Name="SkillsListPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 右侧编辑区 -->
                <Border Grid.Column="1" Background="#FF252535" BorderBrush="#FF3A3A4A"
                        BorderThickness="1" CornerRadius="4" Margin="8,0,0,0">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 名称 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                            <TextBox x:Name="NameBox" Grid.Column="1"
                                     Background="#FF1A1A28" Foreground="#FFE0E0E8"
                                     BorderBrush="#FF3A3A4A" BorderThickness="1"
                                     Padding="6,4"/>
                        </Grid>

                        <!-- 描述 -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="描述" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                            <TextBox x:Name="DescBox" Grid.Column="1"
                                     Background="#FF1A1A28" Foreground="#FFE0E0E8"
                                     BorderBrush="#FF3A3A4A" BorderThickness="1"
                                     Padding="6,4"/>
                        </Grid>

                        <!-- 作者 + 版本 -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="作者" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                            <TextBox x:Name="AuthorBox" Grid.Column="1"
                                     Background="#FF1A1A28" Foreground="#FFE0E0E8"
                                     BorderBrush="#FF3A3A4A" BorderThickness="1"
                                     Padding="6,4"/>
                            <TextBlock Text="版本" Grid.Column="2" FontSize="12"
                                       VerticalAlignment="Center" Foreground="#FF9090A0" Margin="8,0,0,0"/>
                            <TextBox x:Name="VersionBox" Grid.Column="3"
                                     Background="#FF1A1A28" Foreground="#FFE0E0E8"
                                     BorderBrush="#FF3A3A4A" BorderThickness="1"
                                     Padding="6,4"/>
                        </Grid>

                        <!-- Markdown 正文标签 -->
                        <TextBlock Grid.Row="3" Text="Markdown 正文（Skill 提示词内容）" FontSize="12"
                                   Margin="0,4,0,6" Foreground="#FF9090A0"/>

                        <!-- 模板按钮 -->
                        <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="联网搜索" Width="72" Height="24" Margin="0,0,6,0"
                                    Background="Transparent" Foreground="#FF9090A0"
                                    BorderBrush="#FF3A3A4A" BorderThickness="1"
                                    FontSize="11" Cursor="Hand" Click="Template_Click" Tag="web-search"/>
                            <Button Content="代码审查" Width="72" Height="24" Margin="0,0,6,0"
                                    Background="Transparent" Foreground="#FF9090A0"
                                    BorderBrush="#FF3A3A4A" BorderThickness="1"
                                    FontSize="11" Cursor="Hand" Click="Template_Click" Tag="code-review"/>
                            <Button Content="公文写作" Width="72" Height="24" Margin="0,0,6,0"
                                    Background="Transparent" Foreground="#FF9090A0"
                                    BorderBrush="#FF3A3A4A" BorderThickness="1"
                                    FontSize="11" Cursor="Hand" Click="Template_Click" Tag="official-writing"/>
                            <Button Content="会议纪要" Width="72" Height="24"
                                    Background="Transparent" Foreground="#FF9090A0"
                                    BorderBrush="#FF3A3A4A" BorderThickness="1"
                                    FontSize="11" Cursor="Hand" Click="Template_Click" Tag="meeting-minutes"/>
                        </WrapPanel>

                        <TextBox x:Name="BodyBox" Grid.Row="5"
                                 Background="#FF1A1A28" Foreground="#FFE0E0E8"
                                 BorderBrush="#FF3A3A4A" BorderThickness="1"
                                 Padding="8,6"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>

                        <!-- 状态提示 -->
                        <TextBlock x:Name="StatusText" Grid.Row="6" Text="" FontSize="11"
                                   Foreground="#FF9090A0" Margin="0,6,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button x:Name="DeleteBtn" Content="删除" Width="72" Height="32" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#FFEF4444"
                        BorderBrush="#FFEF4444" BorderThickness="1" Cursor="Hand"
                        Click="Delete_Click"/>
                <Button Content="保存" Width="72" Height="32" Margin="0,0,8,0"
                        Background="#FF3B82F6" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                        Click="Save_Click"/>
                <Button Content="关闭" Width="72" Height="32"
                        Background="Transparent" Foreground="#FF9090A0"
                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
