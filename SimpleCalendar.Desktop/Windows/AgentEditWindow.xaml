<Window x:Class="SimpleCalendar.Windows.AgentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑Agent"
        Width="560" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- 美化的滚动条样式 -->
        <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF3A3A4A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border CornerRadius="4" Background="Transparent"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" CornerRadius="4" Background="#FF606070" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF808090" TargetName="thumbBorder"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BeautifulScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1" Grid.Row="0"
                                       Style="{StaticResource ThinScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Column="0" Grid.Row="1"
                                       Orientation="Horizontal"
                                       Style="{StaticResource ThinScrollBarStyle}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF1A1A28" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="新建Agent" FontSize="15" FontWeight="Bold"
                           Foreground="#FFE0E0E8" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" FontSize="13" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FF9090A0" Cursor="Hand"
                        Click="Cancel_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 内容（支持滚动 + 美化滚动条） -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource BeautifulScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="20,0,20,10" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图标" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                        <TextBox x:Name="IconBox" Grid.Column="1" Text="🤖" FontSize="16"
                                 Background="#FF252535" Foreground="#FFE0E0E8"
                                 BorderBrush="#FF3A3A4A" BorderThickness="1"
                                 Padding="8,6" MaxLength="4"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                        <TextBox x:Name="NameBox" Grid.Column="1"
                                 Background="#FF252535" Foreground="#FFE0E0E8"
                                 BorderBrush="#FF3A3A4A" BorderThickness="1"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="描述" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                        <TextBox x:Name="DescBox" Grid.Column="1"
                                 Background="#FF252535" Foreground="#FFE0E0E8"
                                 BorderBrush="#FF3A3A4A" BorderThickness="1"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="温度" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <Slider x:Name="TempSlider" Minimum="0" Maximum="2" TickFrequency="0.1"
                                    Value="0.7" Width="200" VerticalAlignment="Center"
                                    ValueChanged="TempSlider_ValueChanged"/>
                            <TextBlock x:Name="TempValue" Text="0.7" FontSize="12"
                                       Foreground="#FFE0E0E8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="系统提示词" FontSize="12" Margin="0,4,0,6" Foreground="#FF9090A0"/>
                    <TextBox x:Name="PromptBox"
                             Background="#FF252535" Foreground="#FFE0E0E8"
                             BorderBrush="#FF3A3A4A" BorderThickness="1"
                             Padding="8,6" Height="180"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Hidden"
                             HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="PromptBox_PreviewMouseWheel"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>

                    <!-- 高级能力（全局自动启用，无需手动开关） -->
                    <TextBlock Text="扩展能力（已全局自动启用）" FontSize="12" Margin="0,12,0,6" Foreground="#FF9090A0"/>
                    <Border Background="#FF252535" BorderBrush="#FF3A3A4A" BorderThickness="1" CornerRadius="4" Padding="8,6">
                        <StackPanel>
                            <TextBlock Margin="0,2,0,2" FontSize="11" Foreground="#FF60A5FA" TextWrapping="Wrap">
                                <Run Text="✓ MCP 工具  —  "/>
                                <Run Text="所有已连接的 MCP 服务器工具已自动接入此 Agent"/>
                            </TextBlock>
                            <TextBlock Margin="0,2,0,2" FontSize="11" Foreground="#FF60A5FA" TextWrapping="Wrap">
                                <Run Text="✓ Skills  —  "/>
                                <Run Text="所有已启用的 Skill 已注册为可调用工具，AI 会按需自动调用"/>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,2" FontSize="10" Foreground="#FF707080" TextWrapping="Wrap"
                                       Text="在 设置 → 扩展能力 中管理 MCP 服务器和 Skills"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,8,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大工具调用步数" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <Slider x:Name="MaxStepsSlider" Minimum="1" Maximum="30" TickFrequency="1"
                                    Value="10" Width="200" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="MaxStepsSlider_ValueChanged"/>
                            <TextBlock x:Name="MaxStepsValue" Text="10" FontSize="12"
                                       Foreground="#FFE0E0E8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="工具能力（Agent 可调用的工具）" FontSize="12" Margin="0,4,0,6" Foreground="#FF9090A0"/>
                    <Border Background="#FF252535" BorderBrush="#FF3A3A4A" BorderThickness="1" CornerRadius="4" Padding="8,6">
                        <StackPanel x:Name="ToolsPanel">
                            <!-- 工具复选框动态生成 -->
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button Content="取消" Width="72" Height="32" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#FF9090A0"
                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                        Click="Cancel_Click"/>
                <Button Content="保存" Width="72" Height="32"
                        Background="#FF3B82F6" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
