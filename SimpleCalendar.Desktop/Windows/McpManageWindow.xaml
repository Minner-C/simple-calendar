<Window x:Class="SimpleCalendar.Windows.McpManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP 服务器管理"
        Width="760" Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI">

    <Border Background="#FF1A1A28" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔌 MCP 服务器管理" FontSize="15" FontWeight="Bold"
                           Foreground="#FFE0E0E8" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" FontSize="13" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FF9090A0" Cursor="Hand"
                        Click="Close_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 主体：左侧列表 + 右侧编辑区 -->
            <Grid Grid.Row="1" Margin="20,0,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：服务器列表 -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="服务器列表" FontSize="12" Foreground="#FF9090A0" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" Background="#FF1E1E2E" BorderBrush="#FF3A3A4A" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ServerListPanel" Margin="6"/>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Row="2" Content="+ 新建服务器" Height="30" Margin="0,8,0,0"
                            Background="#FF3B82F6" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="New_Click"/>
                </Grid>

                <!-- 右侧：编辑区 -->
                <Border Grid.Column="1" Background="#FF1E1E2E" BorderBrush="#FF3A3A4A" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,12">
                            <TextBlock Text="服务器配置" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFE0E0E8" Margin="0,0,0,12"/>

                            <!-- 服务器名称 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                                <TextBox x:Name="NameBox" Grid.Column="1"
                                         Background="#FF252535" Foreground="#FFE0E0E8"
                                         BorderBrush="#FF3A3A4A" BorderThickness="1"
                                         Padding="8,6" CaretBrush="#FFE0E0E8"/>
                            </Grid>

                            <!-- 类型 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="类型" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                                <ComboBox x:Name="TypeCombo" Grid.Column="1"
                                          Style="{DynamicResource SettingsComboBoxStyle}"
                                          SelectionChanged="Type_SelectionChanged">
                                    <ComboBoxItem Content="stdio（本地命令）" Tag="stdio"/>
                                    <ComboBoxItem Content="http（HTTP 接口）" Tag="http"/>
                                    <ComboBoxItem Content="sse（SSE 流式）" Tag="sse"/>
                                </ComboBox>
                            </Grid>

                            <!-- stdio 模式字段 -->
                            <StackPanel x:Name="StdioPanel">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="命令" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                                    <TextBox x:Name="CommandBox" Grid.Column="1"
                                             Background="#FF252535" Foreground="#FFE0E0E8"
                                             BorderBrush="#FF3A3A4A" BorderThickness="1"
                                             Padding="8,6" CaretBrush="#FFE0E0E8"/>
                                </Grid>
                                <TextBlock Text="参数（每行一个）" FontSize="12" Margin="72,0,0,6" Foreground="#FF9090A0"/>
                                <TextBox x:Name="ArgsBox" Margin="72,0,0,10"
                                         Background="#FF252535" Foreground="#FFE0E0E8"
                                         BorderBrush="#FF3A3A4A" BorderThickness="1"
                                         Padding="8,6" Height="76"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12" CaretBrush="#FFE0E0E8"/>
                            </StackPanel>

                            <!-- http/sse 模式字段 -->
                            <StackPanel x:Name="HttpPanel">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="URL" FontSize="12" VerticalAlignment="Center" Foreground="#FF9090A0"/>
                                    <TextBox x:Name="UrlBox" Grid.Column="1"
                                             Background="#FF252535" Foreground="#FFE0E0E8"
                                             BorderBrush="#FF3A3A4A" BorderThickness="1"
                                             Padding="8,6" CaretBrush="#FFE0E0E8"/>
                                </Grid>
                                <TextBlock Text="请求头（每行 key: value）" FontSize="12" Margin="72,0,0,6" Foreground="#FF9090A0"/>
                                <TextBox x:Name="HeadersBox" Margin="72,0,0,10"
                                         Background="#FF252535" Foreground="#FFE0E0E8"
                                         BorderBrush="#FF3A3A4A" BorderThickness="1"
                                         Padding="8,6" Height="56"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12" CaretBrush="#FFE0E0E8"/>
                            </StackPanel>

                            <!-- 环境变量 -->
                            <TextBlock Text="环境变量（每行 key=value）" FontSize="12" Margin="0,0,0,6" Foreground="#FF9090A0"/>
                            <TextBox x:Name="EnvBox"
                                     Background="#FF252535" Foreground="#FFE0E0E8"
                                     BorderBrush="#FF3A3A4A" BorderThickness="1"
                                     Padding="8,6" Height="56"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12"
                                     Margin="0,0,0,10" CaretBrush="#FFE0E0E8"/>

                            <!-- 启用 -->
                            <CheckBox x:Name="EnabledCheck" Content="启用此服务器" Margin="0,0,0,12"
                                      Style="{DynamicResource SettingsCheckBoxStyle}"
                                      IsChecked="True"
                                      Checked="EnabledCheck_Changed" Unchecked="EnabledCheck_Changed"/>

                            <!-- 模板按钮 -->
                            <TextBlock Text="快速模板（一键填充，需安装 Node.js）" FontSize="12" Margin="0,0,0,6" Foreground="#FF9090A0"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="🌐 网页抓取" Height="28" Margin="0,0,6,6"
                                        Background="#FF252535" Foreground="#FFE0E0E8"
                                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                                        ToolTip="抓取网页内容，无需API Key"
                                        Click="TemplateFetch_Click"/>
                                <Button Content="📁 文件系统" Height="28" Margin="0,0,6,6"
                                        Background="#FF252535" Foreground="#FFE0E0E8"
                                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                                        ToolTip="读写本地文件"
                                        Click="TemplateFilesystem_Click"/>
                                <Button Content="🐙 GitHub" Height="28" Margin="0,0,6,6"
                                        Background="#FF252535" Foreground="#FFE0E0E8"
                                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                                        ToolTip="GitHub仓库管理，需Token"
                                        Click="TemplateGithub_Click"/>
                                <Button Content="🗄 SQLite" Height="28" Margin="0,0,6,6"
                                        Background="#FF252535" Foreground="#FFE0E0E8"
                                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                                        ToolTip="SQLite数据库查询"
                                        Click="TemplateSqlite_Click"/>
                                <Button Content="🧠 记忆库" Height="28" Margin="0,0,6,6"
                                        Background="#FF252535" Foreground="#FFE0E0E8"
                                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                                        ToolTip="知识图谱记忆，本地存储"
                                        Click="TemplateMemory_Click"/>
                                <Button Content="🔗 HTTP 服务器" Height="28" Margin="0,0,6,6"
                                        Background="#FF252535" Foreground="#FFE0E0E8"
                                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                                        ToolTip="连接远程HTTP MCP服务器"
                                        Click="TemplateHttp_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button Content="删除" Width="72" Height="32" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#FFEF4444"
                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                        Click="Delete_Click"/>
                <Button Content="重新连接" Width="88" Height="32" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#FFE0E0E8"
                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                        Click="Reconnect_Click"/>
                <Button Content="保存" Width="72" Height="32" Margin="0,0,8,0"
                        Background="#FF3B82F6" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                        Click="Save_Click"/>
                <Button Content="关闭" Width="72" Height="32"
                        Background="Transparent" Foreground="#FF9090A0"
                        BorderBrush="#FF3A3A4A" BorderThickness="1" Cursor="Hand"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
