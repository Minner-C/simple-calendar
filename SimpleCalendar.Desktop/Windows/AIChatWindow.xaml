<Window x:Class="SimpleCalendar.Windows.AIChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 助手"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        Topmost="False"
        Icon="pack://application:,,,/app.ico"
        Deactivated="Window_Deactivated"
        Closed="Window_Closed"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        Width="1120" Height="720"
        MinWidth="900" MinHeight="600">

    <Border Background="{DynamicResource ChatBg}"
            CornerRadius="12"
            BorderBrush="{DynamicResource ChatBorder}"
            BorderThickness="1"
            Margin="4">
        <!-- 移除DropShadowEffect：AllowsTransparency窗口下Effect走软件渲染，是卡顿元凶 -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- 左栏：历史记录（可折叠，展开260/折叠60） -->
                <ColumnDefinition x:Name="HistoryCol" Width="260"/>
                <!-- 中栏：对话主区 -->
                <ColumnDefinition Width="*"/>
                <!-- 右栏：产物面板（可折叠） -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 统一顶部栏（跨三栏） ===== -->
            <Border Grid.Row="0" Grid.ColumnSpan="3"
                    Background="{DynamicResource ChatHeaderBg}"
                    BorderBrush="{DynamicResource ChatBorder}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0">
                <Grid Margin="10,8,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 历史栏收起/展开按钮（顶栏最左侧） -->
                    <Button Grid.Column="0" x:Name="ToggleHistoryBtn" Content="&#xE76B;" FontSize="13" Width="28" Height="28"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{DynamicResource ChatIconButtonStyle}" Padding="0" Margin="0,0,8,0"
                            Click="ToggleCollapseHistory_Click" VerticalAlignment="Center"
                            ToolTip="收起侧栏"/>

                    <!-- 标题 -->
                    <StackPanel x:Name="HistoryTitlePanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontFamily="Segoe UI Emoji"
                                   Foreground="{DynamicResource ChatTextMain}"/>
                        <TextBlock Text="AI 助手" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ChatTextMain}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 中：留空 -->
                    <TextBlock Grid.Column="2" Text=""/>

                    <!-- 操作按钮 -->
                    <Button Grid.Column="3" x:Name="HistoryBtn" Content="🕘 历史" FontSize="11"
                            Style="{DynamicResource ChatIconButtonStyle}" Padding="8,4"
                            Click="ToggleHistory_Click" Margin="0,0,4,0"
                            ToolTip="刷新历史记录" Visibility="Collapsed"/>
                    <Button Grid.Column="4" x:Name="ClearBtn" Content="🧹 清空" FontSize="11"
                            Style="{DynamicResource ChatIconButtonStyle}" Padding="8,4"
                            Click="Clear_Click" Margin="0,0,4,0"
                            ToolTip="清空当前对话"/>
                    <Button Grid.Column="5" x:Name="ArtifactsToggleBtn" Content="📦 侧栏" FontSize="11"
                            Style="{DynamicResource ChatIconButtonStyle}" Padding="8,4"
                            Click="ToggleArtifacts_Click" Margin="0,0,4,0"
                            ToolTip="显示/隐藏侧栏（产物/搜索/待办）"/>

                    <!-- 右：窗口控制按钮 -->
                    <Button Grid.Column="6" x:Name="MinimizeBtn" Content="&#xE921;" FontSize="13" Width="28" Height="28"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{DynamicResource ChatIconButtonStyle}" Padding="0" Margin="0,0,4,0"
                            Click="Minimize_Click" VerticalAlignment="Center"
                            ToolTip="最小化（任务继续后台运行）"/>
                    <Button Grid.Column="7" x:Name="MaximizeBtn" Content="&#xE922;" FontSize="13" Width="28" Height="28"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{DynamicResource ChatIconButtonStyle}" Padding="0" Margin="0,0,4,0"
                            Click="Maximize_Click" VerticalAlignment="Center"
                            ToolTip="最大化"/>
                    <Button Grid.Column="8" x:Name="CloseBtn" Content="✕" FontSize="13" Width="28" Height="28"
                            Style="{DynamicResource ChatIconButtonStyle}" Padding="0" Margin="6,0,0,0"
                            Click="Close_Click" VerticalAlignment="Center"
                            ToolTip="关闭"/>
                </Grid>
            </Border>

            <!-- ===== 左栏：历史记录（可折叠，收起/展开按钮已移至顶部栏） ===== -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{DynamicResource ChatHistoryBg}"
                    BorderBrush="{DynamicResource ChatBorder}" BorderThickness="0,0,1,0"
                    CornerRadius="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 新对话按钮（展开态） -->
                    <Button Grid.Row="0" x:Name="NewChatBtn" Content="➕  新对话"
                            Style="{DynamicResource ChatPrimaryButtonStyle}"
                            Margin="10,10,10,10" Padding="10,8"
                            HorizontalAlignment="Stretch"
                            Click="NewChat_Click"
                            ToolTip="开始新对话"/>

                    <!-- 新对话按钮（折叠态，仅图标） -->
                    <Button Grid.Row="0" x:Name="NewChatCollapsedBtn" Content="➕"
                            Style="{DynamicResource ChatIconButtonStyle}"
                            Margin="10,10,10,10" Padding="0" Width="36" Height="36"
                            HorizontalAlignment="Center"
                            Click="NewChat_Click"
                            ToolTip="开始新对话"
                            Visibility="Collapsed"/>

                    <!-- 历史记录列表（展开态） -->
                    <ListBox x:Name="HistoryList" Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,0,6,8"
                             ItemContainerStyle="{DynamicResource ChatHistoryListItemStyle}"
                             SelectionChanged="HistoryList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Cursor="Hand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="150"/>
                                            <!-- 运行中状态标记 -->
                                            <Border Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}"
                                                    Background="#3359E0" CornerRadius="3" Padding="4,1,4,1"
                                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="运行中" FontSize="9" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource ChatTextMuted}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" FontSize="11" Width="20" Height="20"
                                            Style="{DynamicResource ChatIconButtonStyle}"
                                            Padding="0" Margin="8,0,0,0"
                                            Tag="{Binding Id}"
                                            Click="DeleteHistory_Click"
                                            Focusable="False"
                                            VerticalAlignment="Center"
                                            ToolTip="删除"
                                            Opacity="0.6"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===== 中栏：对话主区（无标题栏，标题在统一顶栏） ===== -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 消息列表 -->
                <ScrollViewer x:Name="MessagesScroll" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource ChatConversationBg}" Padding="20,12">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Background" Value="{DynamicResource ChatScrollbarBg}"/>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="MessagesPanel"/>
                </ScrollViewer>

                <!-- 实时转写面板（录音时显示） -->
                <Border x:Name="TranscriptionPanel" Grid.Row="1"
                        Background="{DynamicResource ChatReasoningBg}"
                        BorderBrush="{DynamicResource ChatReasoningBorder}"
                        BorderThickness="1,1,1,0"
                        Margin="12,0,12,0" Padding="10,8"
                        CornerRadius="6,6,0,0"
                        Visibility="Collapsed" MaxHeight="120">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="🎙 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TranscriptionStatus" Text="实时转写中..." FontSize="11"
                                       Foreground="#FFEF4444" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TranscriptionHint" Text="（停止录音后将自动发送给AI）" FontSize="10"
                                       Foreground="{DynamicResource ChatTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="80">
                            <TextBlock x:Name="TranscriptionText" Text="" FontSize="12"
                                       Foreground="{DynamicResource ChatTextMain}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 输入区（底部工具栏集成模型切换 + 发送按钮） -->
                <Border Grid.Row="2" Background="{DynamicResource ChatInputBg}"
                        BorderBrush="{DynamicResource ChatBorder}" BorderThickness="1,1,0,0"
                        Margin="12,0,12,12" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 多行输入框 -->
                        <Grid Grid.Row="0">
                            <TextBox x:Name="InputBox"
                                     Style="{DynamicResource ChatTextBoxStyle}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     MaxHeight="180" MinHeight="72"
                                     BorderThickness="0"
                                     Padding="12,10"
                                     PreviewKeyDown="InputBox_PreviewKeyDown"
                                     TextChanged="InputBox_TextChanged"/>

                            <TextBlock x:Name="PlaceholderText"
                                       Text="输入消息，Enter 发送，Shift+Enter 换行..."
                                       FontSize="13" Foreground="{DynamicResource ChatTextMuted}"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Margin="22,14,0,0" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <!-- 底部工具栏：模型 + 录音 + 发送（与输入框同色 #1E1E1E） -->
                        <Border Grid.Row="1" Background="{DynamicResource ChatInputBg}"
                                BorderThickness="0"
                                CornerRadius="0,0,10,10" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 模型选择 -->
                                <ComboBox x:Name="ModelCombo" Grid.Column="0"
                                          Width="180" Margin="0,0,8,0"
                                          Style="{DynamicResource ChatComboBoxStyle}"
                                          ItemContainerStyle="{DynamicResource ChatComboBoxItemStyle}"
                                          SelectionChanged="ModelCombo_SelectionChanged"
                                          ToolTip="切换模型">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- 中间留空 -->
                                <TextBlock Grid.Column="1" Text=""/>

                                <!-- 字数提示 -->
                                <TextBlock x:Name="CharCountText" Grid.Column="2"
                                           Text="0" FontSize="10"
                                           Foreground="{DynamicResource ChatTextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <!-- 录音按钮 -->
                                <Button x:Name="RecordBtn" Grid.Column="3" Content="🎤" Width="32" Height="28"
                                        Style="{DynamicResource ChatIconButtonStyle}"
                                        Click="Record_Click"
                                        ToolTip="开始/停止录音"/>
                                <TextBlock x:Name="RecordStatus" Grid.Column="4" Text="" FontSize="10"
                                           Foreground="#FFEF4444" VerticalAlignment="Center" Margin="4,0,8,0"
                                           Visibility="Collapsed"/>

                                <!-- 发送/停止按钮 -->
                                <Button x:Name="SendBtn" Grid.Column="5" Content="发送" Width="72" Height="28"
                                        Style="{DynamicResource ChatPrimaryButtonStyle}"
                                        Click="Send_Click"
                                        ToolTip="发送 (Enter)"/>
                                <Button x:Name="StopBtn" Grid.Column="5" Content="停止" Width="72" Height="28"
                                        Style="{DynamicResource ChatIconButtonStyle}"
                                        BorderBrush="{DynamicResource ChatBorder}" BorderThickness="1"
                                        Click="Stop_Click" Visibility="Collapsed"
                                        ToolTip="停止生成"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 右栏：产物/搜索/待办 三标签面板（可折叠，无标题，标题在统一顶栏） ===== -->
            <Border x:Name="ArtifactsPanel" Grid.Row="1" Grid.Column="2"
                    Width="320"
                    Background="{DynamicResource ChatHistoryBg}"
                    BorderBrush="{DynamicResource ChatBorder}" BorderThickness="1,0,0,0"
                    CornerRadius="0,0,12,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标签切换条 -->
                    <Grid Grid.Row="0" Margin="10,10,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TabArtifactsBtn" Grid.Column="0" Content="📦 产物" FontSize="11"
                                Style="{DynamicResource ChatIconButtonStyle}" Padding="4,6" Margin="0,0,3,0"
                                Click="SwitchSidebarTab_Click" Tag="artifacts" FontWeight="SemiBold"
                                ToolTip="AI 生成的文件"/>
                        <Button x:Name="TabSearchBtn" Grid.Column="1" Content="🔍 搜索" FontSize="11"
                                Style="{DynamicResource ChatIconButtonStyle}" Padding="4,6" Margin="3,0"
                                Click="SwitchSidebarTab_Click" Tag="search"
                                ToolTip="联网搜索结果"/>
                        <Button x:Name="TabTodoBtn" Grid.Column="2" Content="✅ 待办" FontSize="11"
                                Style="{DynamicResource ChatIconButtonStyle}" Padding="4,6" Margin="3,0,0,0"
                                Click="SwitchSidebarTab_Click" Tag="todo"
                                ToolTip="待办事项"/>
                    </Grid>

                    <!-- 产物面板 -->
                    <Grid x:Name="ArtifactsTabGrid" Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                            <StackPanel x:Name="ArtifactsList"/>
                        </ScrollViewer>
                        <TextBlock x:Name="ArtifactsEmptyText"
                                   Text="暂无产物&#x0a;&#x0a;AI 生成的文件、文档将出现在这里"
                                   FontSize="11" Foreground="{DynamicResource ChatTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="20,0,20,40"/>
                    </Grid>

                    <!-- 搜索结果面板 -->
                    <Grid x:Name="SearchTabGrid" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                            <StackPanel x:Name="SearchResultsList"/>
                        </ScrollViewer>
                        <TextBlock x:Name="SearchEmptyText"
                                   Text="暂无搜索结果&#x0a;&#x0a;AI 联网搜索的结果将出现在这里"
                                   FontSize="11" Foreground="{DynamicResource ChatTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="20,0,20,40"/>
                    </Grid>

                    <!-- 待办面板 -->
                    <Grid x:Name="TodoTabGrid" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 待办输入区 -->
                        <StackPanel Grid.Row="0" Margin="10,0,10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TodoInputBox" Grid.Column="0"
                                         Style="{DynamicResource ChatTextBoxStyle}"
                                         FontSize="12" Padding="8,6"
                                         BorderBrush="{DynamicResource ChatBorder}" BorderThickness="1"
                                         KeyDown="TodoInput_KeyDown"
                                         ToolTip="输入待办后回车添加"/>
                                <Button x:Name="TodoAddBtn" Grid.Column="1" Content="＋" FontSize="14"
                                        Width="28" Height="28" Margin="4,0,0,0"
                                        Style="{DynamicResource ChatIconButtonStyle}" Padding="0"
                                        Click="TodoAdd_Click" ToolTip="添加待办"/>
                            </Grid>
                        </StackPanel>
                        <!-- 待办列表 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0,10,6">
                            <StackPanel x:Name="TodoList"/>
                        </ScrollViewer>
                        <!-- 空状态 -->
                        <TextBlock x:Name="TodoEmptyText" Grid.Row="1"
                                   Text="暂无待办&#x0a;&#x0a;输入或让AI添加待办事项"
                                   FontSize="11" Foreground="{DynamicResource ChatTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="20,0,20,40"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
